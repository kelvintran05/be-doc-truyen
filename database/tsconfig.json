{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2021"],
    "typeRoots": ["../backend/node_modules/@types"],
    "types": ["node"],
    "baseUrl": "./",
    "paths": {
      "@prisma/client": ["../backend/node_modules/@prisma/client"]
    },
    "ignoreDeprecations": "6.0"
  }
}
