{
  "scripts": {
    "db:migrate": "npx prisma migrate dev --schema=database/schema.prisma",
    "db:reset": "npx prisma migrate reset --schema=database/schema.prisma --force",
    "db:seed": "npm run db:seed:stories && npm run db:seed:courses && npm run db:seed:scraped && npm run db:seed:local",
    "db:seed:stories": "cd backend && npx prisma db seed",
    "db:seed:courses": "cd backend && npx ts-node --project tsconfig.json ../database/seed_courses.ts",
    "db:seed:scraped": "cd backend && npx ts-node --project tsconfig.json ../database/seed_scraped.ts",
    "db:seed:local": "cd backend && npx ts-node --project tsconfig.json ../database/seed_local_imported.ts"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
